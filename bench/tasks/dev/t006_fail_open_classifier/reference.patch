+    """Ask `ask_model` (a function from a prompt to the model's reply) what `text` wants.
+
+    A reply that cannot be understood holds the message back: a guard that fails open is not a guard.
+    """
+    intent = _read_intent(ask_model(PROMPT + text))
+    if intent is None:
+        return Verdict(blocked=True, intent="unknown")
     return Verdict(blocked=intent in BLOCKED_INTENTS, intent=intent)
+
+
+def _read_intent(reply: str) -> str | None:
+    """The intent in the reply, with or without a code fence around it, or None if there is none."""
+    text = reply.strip()
+    fenced = _FENCE.fullmatch(text)
+    if fenced:
+        text = fenced.group(1)
+    try:
+        result = json.loads(text)
+    except json.JSONDecodeError:
+        return None
+    intent = result.get("intent") if isinstance(result, dict) else None
+    return intent if isinstance(intent, str) else None
